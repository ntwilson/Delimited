<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- OWN PACKAGES FOLDER SO test-package.ps1 CAN EVICT A CACHED Delimited WITHOUT TOUCHING THE MACHINE-WIDE CACHE. -->
  <config>
    <add key="globalPackagesFolder" value="../artifacts/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="local" value="../artifacts" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Delimited ONLY FROM THE LOCAL PACK, NEVER THE PUBLISHED ONE. -->
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="Delimited" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
